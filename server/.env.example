PORT=5001
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=replace-with-a-unique-password-at-least-8-characters
TOKEN_SECRET=replace-with-a-random-secret-at-least-32-characters-long
CLIENT_URL=http://localhost:5173
# Optional for local development. In production, use a Supabase Postgres
# Session Pooler connection string; Render's filesystem is ephemeral.
# DATABASE_URL=postgresql://...
# Set an OpenAI API key to enable the authenticated AI Buddy endpoint.
OPENAI_API_KEY=
# Optional; defaults to gpt-4o-mini.
OPENAI_MODEL=gpt-4o-mini
# Optional paid alternative for durable direct video uploads (Cloudflare R2).
# R2_ACCOUNT_ID=
# R2_BUCKET=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
